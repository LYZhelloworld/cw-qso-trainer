{
  "name": "cw-qso-trainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline CW (Morse code) QSO trainer for amateur radio: copy virtual stations, key with a straight key or iambic paddles, and log each practice QSO.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
